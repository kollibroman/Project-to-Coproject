<mxfile host="drawio">
  <diagram id="use-cases" name="Przypadki użycia">
    <mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="880" math="0" shadow="0">
      <root>
