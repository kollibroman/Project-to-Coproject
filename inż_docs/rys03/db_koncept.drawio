        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml diagram_koncepcyjny\n&#39; Conceptual database model – ProjectCowork\n&#39; Notation: crow&#39;s foot (IE). Dashed line = logical reference without a foreign key.\n&#39; Relationship labels = navigation property names from the domain classes.\n\nhide circle\nskinparam linetype ortho\nskinparam shadowing false\nskinparam roundcorner 6\nskinparam entity {\n  BackgroundColor #FDFDFD\n  BorderColor #444444\n}\nskinparam package {\n  BorderColor #888888\n  FontStyle bold\n}\n\ntitle ProjectCowork – conceptual database model\n\npackage \&quot;Users\&quot; {\n  entity \&quot;UserEntity\&quot; as UserEntity {\n    * Id\n    --\n    * UserName\n    * Email\n    * PasswordHash\n    GithubUsername\n    GithubFineGrainedPat\n  }\n\n  entity \&quot;RoleEntity\&quot; as RoleEntity {\n    * Id\n    --\n    * Name\n  }\n\n  entity \&quot;RefreshTokenEntity\&quot; as RefreshTokenEntity {\n    * Id\n    --\n    * Token\n    * ExpiresAt\n    * CreatedAt\n    * UpdatedAt\n  }\n}\n\npackage \&quot;Project\&quot; {\n  entity \&quot;ProjectEntity\&quot; as ProjectEntity {\n    * Id\n    --\n    * Name\n    * Description\n    * LastTaskFriendlyId\n    * CreatedAt\n    * UpdatedAt\n  }\n\n  entity \&quot;ProjectMemberEntity\&quot; as ProjectMemberEntity {\n    * Id\n  }\n\n  entity \&quot;ProjectRoleEntity\&quot; as ProjectRoleEntity {\n    * Id\n    --\n    * Name\n    * IsDefault\n  }\n\n  entity \&quot;ProjectInvitationEntity\&quot; as ProjectInvitationEntity {\n    * Id\n    --\n    * InvitationContent\n    * UserAccepted\n    * IsActive\n    * CreatedAt\n    * UpdatedAt\n  }\n}\n\npackage \&quot;Permissions\&quot; {\n  entity \&quot;ApplicationModuleEntity\&quot; as ApplicationModuleEntity {\n    * Id\n    --\n    * Name\n    * IsActive\n  }\n\n  entity \&quot;FeatureEntity\&quot; as FeatureEntity {\n    * Id\n    --\n    * Name\n  }\n\n  entity \&quot;ActionEntity\&quot; as ActionEntity {\n    * Id\n    --\n    * Name\n  }\n\n  entity \&quot;FeatureActionEntity\&quot; as FeatureActionEntity {\n    * Id\n  }\n}\n\npackage \&quot;Management\&quot; {\n  entity \&quot;SprintEntity\&quot; as SprintEntity {\n    * Id\n    --\n    * Name\n    * StartDate\n    * EndDate\n    * CreatedAt\n    * UpdatedAt\n  }\n\n  entity \&quot;TaskEntity\&quot; as TaskEntity {\n    * Id\n    --\n    * FriendlyId\n    * Name\n    * Description\n    * Status\n    * Priority\n    FinishedDate\n    * CreatedAt\n    * UpdatedAt\n  }\n}\n\npackage \&quot;Posting\&quot; {\n  entity \&quot;ProjectPostingEntity\&quot; as ProjectPostingEntity {\n    * Id\n    --\n    * JobDescription\n    * ProjectDescription\n    * IsActive\n    * CreatedAt\n    * UpdatedAt\n  }\n\n  entity \&quot;ProjectApplicationEntity\&quot; as ProjectApplicationEntity {\n    * Id\n    --\n    * Description\n    * CreatedAt\n    * UpdatedAt\n  }\n}\n\npackage \&quot;Attachments\&quot; {\n  entity \&quot;AttachmentEntity\&quot; as AttachmentEntity {\n    * Id\n    --\n    * FileName\n    * PersistedFileName\n    * SizeInBytes\n    BlobUrl\n    * CreatedAt\n    * UpdatedAt\n  }\n}\n\npackage \&quot;Repositories\&quot; {\n  entity \&quot;RepositoryEntity\&quot; as RepositoryEntity {\n    * Id\n    --\n    * RepositoryName\n    * RepoPath\n    * CreatedAt\n    * UpdatedAt\n  }\n}\n\n&#39; --- Users ---\nUserEntity }o--o{ RoleEntity : AspNetUserRoles\nUserEntity ||--o| RefreshTokenEntity : RefreshToken\n\n&#39; --- Project ---\nUserEntity ||--o{ ProjectEntity : OwnedProjects\nUserEntity ||--o{ ProjectMemberEntity : AssignedProjects\nProjectEntity ||--o{ ProjectMemberEntity : ProjectMembers\nProjectRoleEntity ||--o{ ProjectMemberEntity : ProjectRole\nProjectEntity ||--o{ ProjectRoleEntity : ProjectRoles\nProjectEntity ||--o{ ProjectInvitationEntity : ProjectInvitations\nUserEntity ||--o{ ProjectInvitationEntity : ProjectInvitations\nProjectRoleEntity |o..o{ ProjectInvitationEntity : RoleId\n\n&#39; --- Permissions ---\nApplicationModuleEntity }o--o{ FeatureEntity : Features / Modules\nFeatureEntity ||--o{ FeatureActionEntity : Feature\nActionEntity ||--o{ FeatureActionEntity : Features\nProjectRoleEntity }o--o{ FeatureActionEntity : FeatureActions / ProjectRoles\n\n&#39; --- Management ---\nProjectEntity ||--o{ SprintEntity : Sprints\nProjectEntity ||--o{ TaskEntity : Tasks\nSprintEntity |o--o{ TaskEntity : Tasks\nUserEntity |o--o{ TaskEntity : AssignedUser\n\n&#39; --- Posting ---\nProjectEntity ||--o{ ProjectPostingEntity : ProjectPostings\nProjectPostingEntity ||--o{ ProjectApplicationEntity : Applications\nUserEntity ||--o{ ProjectApplicationEntity : ProjectApplications\nProjectApplicationEntity |o--o{ AttachmentEntity : Attachments\n\n&#39; --- Repositories ---\nProjectEntity ||--o{ RepositoryEntity : Repositories\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="W9TmxrKt6cQx_CgD7wpf-419">
