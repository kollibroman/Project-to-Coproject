        <UserObject label="" plantUmlData="{&#10;  &quot;data&quot;: &quot;@startuml diagram_klas\n' Class diagram – ProjectCowork.Domain.Models\n\nskinparam shadowing false\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam package {\n  BorderColor #888888\n  FontStyle bold\n}\n\ntitle ProjectCowork.Domain.Models – class diagram\n\npackage \&quot;Microsoft.AspNetCore.Identity\&quot; #EEEEEE {\n  class \&quot;IdentityUser&lt;Guid&gt;\&quot; as IdentityUser &lt;&lt;external&gt;&gt;\n  class \&quot;IdentityRole&lt;Guid&gt;\&quot; as IdentityRole &lt;&lt;external&gt;&gt;\n}\n\npackage \&quot;Models\&quot; {\n  class BaseTrackedEntity {\n    + CreatedAt : DateTimeOffset\n    + UpdatedAt : DateTimeOffset\n  }\n}\n\npackage \&quot;Enums.Management\&quot; {\n  enum TaskStatus {\n    Todo = 0\n    InProgress = 1\n    Done = 2\n  }\n\n  enum TaskPriority {\n    Critical = 0\n    Urgent = 1\n    Normal = 2\n    BySometime = 3\n    InFuture = 4\n  }\n}\n\npackage \&quot;Models.Users\&quot; {\n  class UserEntity {\n    + GithubUsername : string?\n    + GithubFineGrainedPat : string?\n    + RefreshToken : RefreshTokenEntity\n    + OwnedProjects : ICollection&lt;ProjectEntity&gt;\n    + AssignedProjects : ICollection&lt;ProjectMemberEntity&gt;\n    + ProjectApplications : ICollection&lt;ProjectApplicationEntity&gt;\n    + ProjectInvitations : ICollection&lt;ProjectInvitationEntity&gt;\n  }\n\n  class RoleEntity\n\n  class RefreshTokenEntity {\n    + Id : Guid {readOnly}\n    + Token : string {readOnly}\n    + ExpiresAt : DateTime {readOnly}\n    + UserId : Guid\n    + User : UserEntity\n  }\n}\n\npackage \&quot;Models.Project\&quot; {\n  class ProjectEntity {\n    + Id : Guid {readOnly}\n    + Name : string\n    + Description : string\n    + OwnerId : Guid\n    + Owner : UserEntity\n    + LastTaskFriendlyId : long\n    + Sprints : ICollection&lt;SprintEntity&gt;\n    + Tasks : ICollection&lt;TaskEntity&gt;\n    + ProjectPostings : ICollection&lt;ProjectPostingEntity&gt;\n    + ProjectMembers : ICollection&lt;ProjectMemberEntity&gt;\n    + ProjectRoles : ICollection&lt;ProjectRoleEntity&gt;\n    + Repositories : ICollection&lt;RepositoryEntity&gt;\n    + ProjectInvitations : ICollection&lt;ProjectInvitationEntity&gt;\n  }\n\n  class ProjectMemberEntity {\n    + Id : Guid {readOnly}\n    + UserId : Guid\n    + User : UserEntity\n    + ProjectId : Guid\n    + Project : ProjectEntity\n    + ProjectRoleId : Guid\n    + ProjectRole : ProjectRoleEntity\n  }\n\n  class ProjectRoleEntity {\n    + Id : Guid {readOnly}\n    + Name : string\n    + IsDefault : bool\n    + ProjectId : Guid\n    + Project : ProjectEntity\n    + FeatureActions : ICollection&lt;FeatureActionEntity&gt;\n  }\n\n  class ProjectInvitationEntity {\n    + Id : Guid {readOnly}\n    + InvitationContent : string {readOnly}\n    + UserAccepted : bool\n    + IsActive : bool\n    + RoleId : Guid? {readOnly}\n    + ProjectId : Guid {readOnly}\n    + Project : ProjectEntity\n    + UserId : Guid {readOnly}\n    + User : UserEntity\n  }\n}\n\npackage \&quot;Models.Permissions\&quot; {\n  class ApplicationModuleEntity {\n    + Id : int\n    + Name : string\n    + IsActive : bool\n    + Features : ICollection&lt;FeatureEntity&gt;\n  }\n\n  class FeatureEntity {\n    + Id : int {readOnly}\n    + Name : string\n    + Modules : ICollection&lt;ApplicationModuleEntity&gt;\n  }\n\n  class ActionEntity {\n    + Id : int\n    + Name : string\n    + Features : ICollection&lt;FeatureActionEntity&gt;\n  }\n\n  class FeatureActionEntity {\n    + Id : int\n    + FeatureId : int\n    + Feature : FeatureEntity\n    + ActionId : int\n    + Action : ActionEntity\n    + ProjectRoles : ICollection&lt;ProjectRoleEntity&gt;\n  }\n}\n\npackage \&quot;Models.Management\&quot; {\n  class SprintEntity {\n    + Id : Guid {readOnly}\n    + Name : string\n    + StartDate : DateOnly\n    + EndDate : DateOnly\n    + ProjectId : Guid\n    + Project : ProjectEntity\n    + Tasks : ICollection&lt;TaskEntity&gt;\n  }\n\n  class TaskEntity {\n    + Id : Guid {readOnly}\n    + Name : string\n    + Description : string\n    + Status : TaskStatus\n    + Priority : TaskPriority\n    + FinishedDate : DateOnly?\n    + FriendlyId : long {readOnly}\n    + AssignedUserId : Guid?\n    + AssignedUser : UserEntity?\n    + ProjectId : Guid\n    + Project : ProjectEntity\n    + SprintId : Guid?\n    + Sprint : SprintEntity?\n  }\n}\n\npackage \&quot;Models.Posting\&quot; {\n  class ProjectPostingEntity {\n    + Id : Guid {readOnly}\n    + JobDescription : string\n    + ProjectDescription : string\n    + ProjectId : Guid\n    + Project : ProjectEntity\n    + Applications : ICollection&lt;ProjectApplicationEntity&gt;\n    + IsActive : bool\n  }\n\n  class ProjectApplicationEntity {\n    + Id : Guid\n    + Description : string\n    + UserId : Guid\n    + User : UserEntity\n    + ProjectPostingId : Guid\n    + ProjectPosting : ProjectPostingEntity\n    + Attachments : ICollection&lt;AttachmentEntity&gt;\n  }\n}\n\npackage \&quot;Models.Attachments\&quot; {\n  class AttachmentEntity {\n    + Id : Guid {readOnly}\n    + FileName : string {readOnly}\n    + PersistedFileName : string {readOnly}\n    + SizeInBytes : long {readOnly}\n    + BlobUrl : string?\n    + ProjectApplicationId : Guid?\n    + ProjectApplication : ProjectApplicationEntity?\n  }\n}\n\npackage \&quot;Models.Repositories\&quot; {\n  class RepositoryEntity {\n    + Id : Guid {readOnly}\n    + RepositoryName : string {readOnly}\n    + RepoPath : string\n    + ProjectId : Guid\n    + Project : ProjectEntity\n  }\n}\n\n' --- Inheritance ---\nIdentityUser &lt;|-- UserEntity\nIdentityRole &lt;|-- RoleEntity\n\nBaseTrackedEntity &lt;|-- RefreshTokenEntity\nBaseTrackedEntity &lt;|-- ProjectEntity\nBaseTrackedEntity &lt;|-- ProjectInvitationEntity\nBaseTrackedEntity &lt;|-- SprintEntity\nBaseTrackedEntity &lt;|-- TaskEntity\nBaseTrackedEntity &lt;|-- ProjectPostingEntity\nBaseTrackedEntity &lt;|-- ProjectApplicationEntity\nBaseTrackedEntity &lt;|-- AttachmentEntity\nBaseTrackedEntity &lt;|-- RepositoryEntity\n\n' --- Associations (navigation properties) ---\nUserEntity \&quot;1\&quot; -- \&quot;0..1\&quot; RefreshTokenEntity\nUserEntity \&quot;1 Owner\&quot; -- \&quot;0..* OwnedProjects\&quot; ProjectEntity\nUserEntity \&quot;1\&quot; -- \&quot;0..* AssignedProjects\&quot; ProjectMemberEntity\nUserEntity \&quot;1\&quot; -- \&quot;0..*\&quot; ProjectInvitationEntity\nUserEntity \&quot;1\&quot; -- \&quot;0..*\&quot; ProjectApplicationEntity\nUserEntity \&quot;0..1 AssignedUser\&quot; &lt;-- \&quot;0..*\&quot; TaskEntity\n\nProjectEntity \&quot;1\&quot; *-- \&quot;0..*\&quot; ProjectMemberEntity\nProjectEntity \&quot;1\&quot; *-- \&quot;0..*\&quot; ProjectRoleEntity\nProjectEntity \&quot;1\&quot; *-- \&quot;0..*\&quot; ProjectInvitationEntity\nProjectEntity \&quot;1\&quot; *-- \&quot;0..*\&quot; SprintEntity\nProjectEntity \&quot;1\&quot; *-- \&quot;0..*\&quot; TaskEntity\nProjectEntity \&quot;1\&quot; *-- \&quot;0..*\&quot; ProjectPostingEntity\nProjectEntity \&quot;1\&quot; *-- \&quot;0..*\&quot; RepositoryEntity\n\nProjectRoleEntity \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; ProjectMemberEntity\nProjectRoleEntity \&quot;0..*\&quot; -- \&quot;0..*\&quot; FeatureActionEntity\n\nApplicationModuleEntity \&quot;0..*\&quot; -- \&quot;0..*\&quot; FeatureEntity\nFeatureEntity \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; FeatureActionEntity\nActionEntity \&quot;1\&quot; -- \&quot;0..* Features\&quot; FeatureActionEntity\n\nSprintEntity \&quot;0..1\&quot; o-- \&quot;0..*\&quot; TaskEntity\nTaskEntity --&gt; TaskStatus\nTaskEntity --&gt; TaskPriority\n\nProjectPostingEntity \&quot;1\&quot; *-- \&quot;0..*\&quot; ProjectApplicationEntity\nProjectApplicationEntity \&quot;0..1\&quot; o-- \&quot;0..*\&quot; AttachmentEntity\n\n@enduml\n&quot;,&#10;  &quot;config&quot;: null&#10;}" id="cCbO4l8CzO3eep_ccfZC-1">
