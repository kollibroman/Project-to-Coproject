  <diagram name="Page-1" id="iq_ashAcNtueXvxjpUoT">
    <mxGraphModel dx="3142" dy="2936" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml diagram_przeplywu_nowe_repozytorium\ntitle Inicjalizacja nowego repozytorium\n\nskinparam ActivityBackgroundColor #FFFFFF\nskinparam ActivityBorderColor #333333\nskinparam SwimlaneTitleFontStyle bold\n\n|Aplikacja kliencka|\nstart\n:Użytkownik podaje nazwę repozytorium\\nw widoku projektu;\n:POST /api/git/repository/create\\n{ name, projectId };\n\n|Warstwa dostępowa\\n(GitController)|\n:Utworzenie komendy\\n**CreateRepositoryCommand**;\n:IMediator.Send(komenda);\n\n|Warstwa aplikacji\\n(CreateRepositoryCommandHandler)|\n:Sprawdzenie uprawnień\\nprzed utworzeniem plików na dysku;\n\n|Autoryzacja\\n(PermissionService)|\nif (Użytkownik zalogowany?) then (nie)\n  :UnauthenticatedException;\n  |Warstwa dostępowa\\n(GitController)|\n  :GlobalExceptionHandler\\nzwraca **401 Unauthorized**;\n  |Aplikacja kliencka|\n  :Wyświetlenie błędu;\n  stop\nelse (tak)\nendif\nif (Rola w projekcie ma uprawnienie\\nRepositories.Create?) then (nie)\n  :ForbiddenException;\n  note right\n    Nieistniejący projekt również daje 403,\n    żeby nie ujawniać istniejących identyfikatorów.\n  end note\n  |Warstwa dostępowa\\n(GitController)|\n  :GlobalExceptionHandler\\nzwraca **403 Forbidden**;\n  |Aplikacja kliencka|\n  :Wyświetlenie błędu;\n  stop\nelse (tak)\nendif\n\n|Integracja Git\\n(GitClientService)|\n:InitBareRepositoryAsync(name, projectId);\nif (Nazwa zgodna z wzorcem\\n[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}?) then (nie)\n  :ArgumentException;\n  |Warstwa dostępowa\\n(GitController)|\n  :GlobalExceptionHandler\\nzwraca **500**;\n  |Aplikacja kliencka|\n  :Wyświetlenie błędu;\n  stop\nelse (tak)\nendif\nif (Katalog Repos/{projectId}/{name}.git\\njuż istnieje?) then (tak)\n  :InvalidOperationException;\n  |Warstwa dostępowa\\n(GitController)|\n  :GlobalExceptionHandler\\nzwraca **500**;\n  |Aplikacja kliencka|\n  :Wyświetlenie błędu;\n  stop\nelse (nie)\nendif\n:Utworzenie katalogu Repos/{projectId};\n:Repository.Init(ścieżka, isBare: true)\\n(LibGit2Sharp);\n:Ustawienie http.receivepack = true\\n(zezwolenie na push przez HTTP);\n:Zapis HEAD -&gt; refs/heads/main;\n:Zbudowanie adresu klonowania\\n{scheme}://{host}/api/git/{projectId}/{name}.git;\n\n|Warstwa aplikacji\\n(CreateRepositoryCommandHandler)|\n:RepositoryAggregate.Create(name, adres, projectId);\n\n|Baza danych\\n(PostgreSQL)|\n:DbContext.Add(RepositoryEntity);\n:SaveChangesAsync();\nnote right\n  Zapis do bazy następuje po utworzeniu\n  repozytorium na dysku. Błąd zapisu\n  pozostawia katalog .git bez wpisu w bazie.\nend note\n\n|Warstwa dostępowa\\n(GitController)|\n:Zwrócenie **200 OK**\\nz adresem klonowania;\n\n|Aplikacja kliencka|\n:Wyświetlenie adresu klonowania;\n:Użytkownik wykonuje\\ngit clone / git push;\nstop\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AqYMRS_dkXeUdvCL_pKe-1">
